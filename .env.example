# ==============================================================================
# FoodVerse AI — Root Environment Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose or local deployment.
# Never commit real credentials to source control.

# Groq Cloud Multimodal & LLM Provider (Phase 1)
# Get your API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=45.0
GROQ_MAX_RETRIES=2

# MongoDB Atlas Persistence & GridFS (Phase 2 & 3)
# Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local URI: mongodb://localhost:27017/foodverse_ai
MONGODB_URI=
MONGODB_DATABASE=foodverse_ai
GRIDFS_MEDIA_BUCKET=foodverse_media

# Anonymous Session Security (Phase 6)
SESSION_SECRET=change-this-in-production-to-a-secure-random-secret
SESSION_COOKIE_NAME=foodverse_session
SESSION_HEADER_NAME=X-Session-ID

# Backend & Frontend Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
